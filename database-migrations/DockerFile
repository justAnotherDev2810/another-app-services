FROM flyway/flyway:10.10.0

# Copy base config and environment-specific properties
COPY config/flyway-base.conf /flyway/conf/flyway-base.conf
COPY config/dev.properties /flyway/conf/dev.properties
COPY config/prod.properties /flyway/conf/prod.properties

# Copy all service migration scripts
# Each service has its own subfolder — Flyway only scans the one it's told to
COPY migrations/ /flyway/sql/

# Copy and set entrypoint script
COPY scripts/migrate.sh /flyway/scripts/migrate.sh

USER root

# Fix Windows line endings and set permissions
RUN apt-get update && apt-get install -y dos2unix \
    && dos2unix /flyway/scripts/migrate.sh \
    && chmod +x /flyway/scripts/migrate.sh \
    && rm -rf /var/lib/apt/lists/*

ENTRYPOINT ["/flyway/scripts/migrate.sh"]